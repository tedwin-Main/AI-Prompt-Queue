{
  "manifest_version": 3,
  "name": "AI Prompt Queue",
  "version": "1.1",
  "description": "Queues multiple messages to be sent sequentially to Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Prompt Queue"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "css": ["content-ui.css"],
      "js": ["utils/gemini-adapter.js", "content.js"]
    }
  ]
}

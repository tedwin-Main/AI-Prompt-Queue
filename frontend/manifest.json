{
  "manifest_version": 3,
  "name": "AI Prompt Queue",
  "version": "1.3",
  "description": "Queue prompts and send them sequentially on ChatGPT, Gemini, and Claude.",
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["content-ui.css"],
      "js": ["components/gemini-adapter.js", "content.js"]
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["content-ui.css"],
      "js": ["components/chatgpt-adapter.js", "content.js"]
    },
    {
      "matches": ["https://claude.ai/*"],
      "css": ["content-ui.css"],
      "js": ["components/claude-adapter.js", "content.js"]
    }
  ]
}
